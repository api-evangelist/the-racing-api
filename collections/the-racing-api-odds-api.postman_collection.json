          "request": {
            "name": "The Racing API Odds Runner",
            "description": {
              "content": "<h4>Get detailed pre-race runner odds data, including price movements, for UK and Irish racing.</h4><table><tbody><tr><td><b>Min. Required Plan</b></td><td>Pro</td></tr><tr><td><b>Rate Limit</b></td><td>5 requests per second</td></tr></tbody></table><p>ℹ️ Price movements, displayed in the 'history' fields, are available for runners in races from 2025-03-17 onwards.</p>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "odds",
                ":race_id",
                ":horse_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
