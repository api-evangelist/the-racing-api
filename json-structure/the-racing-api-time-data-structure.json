{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/the-racing-api/refs/heads/main/json-structure/the-racing-api-time-data-structure.json",
  "name": "TimeData",
  "description": "TimeData schema from The Racing API",
  "type": "object",
  "properties": {
    "minutes": {
      "anyOf": [
        {
